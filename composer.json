{
    "name": "moran1412/filament-anti-brute-force",
    "description": "Brute force login protection for Filament, throttling and locking out malicious IPs and emails.",
    "keywords": [
        "MoRan1412",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-anti-brute-force"
    ],
    "homepage": "https://github.com/moran1412/filament-anti-brute-force",
    "support": {
        "issues": "https://github.com/moran1412/filament-anti-brute-force/issues",
        "source": "https://github.com/moran1412/filament-anti-brute-force"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "MoRan",
            "email": "ooklibaioo@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MoRan1412\\FilamentAntiBruteForce\\": "src/",
            "MoRan1412\\FilamentAntiBruteForce\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MoRan1412\\FilamentAntiBruteForce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MoRan1412\\FilamentAntiBruteForce\\FilamentAntiBruteForceServiceProvider"
            ],
            "aliases": {
                "FilamentAntiBruteForce": "MoRan1412\\FilamentAntiBruteForce\\Facades\\FilamentAntiBruteForce"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}